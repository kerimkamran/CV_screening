# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# The API connects as the least-privilege cv_api role (db/dev/app-login.sql), NOT the owner.
DATABASE_URL=postgres://cv_api:cv_api@localhost:5432/cv_screening
# Migrations run as the schema owner.
MIGRATION_DATABASE_URL=postgres://cv:cv@localhost:5432/cv_screening

# --- Sign-in: built-in accounts (MVP) -------------------------------------------------
AUTH_MODE=local
# openssl rand -base64 48
SESSION_SECRET=change-me-change-me-change-me-change-me-change-me
# First ADMIN, created at boot only while no admin exists; must change the password at first sign-in.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-initial-password
APP_BASE_URL=http://localhost:5173

# --- AI models ---------------------------------------------------------------------
# Provider API keys are entered by an ADMIN in the app (Admin -> AI models), stored encrypted
# in the database, and never returned by any endpoint. This is the master key for that encryption:
#   openssl rand -base64 32
# Losing or changing it makes stored provider keys unreadable (re-enter them).
SETTINGS_ENCRYPTION_KEY=

# --- Email for new-account credentials -------------------------------------------------
# console = nothing is sent; the admin is shown the temporary password once instead.
EMAIL_PROVIDER=console
EMAIL_FROM=Azerconnect CV Screening <no-reply@your-verified-domain>
# RESEND_API_KEY=
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASSWORD=  SMTP_SECURE=false

# --- Alternative sign-in: corporate IdP via OIDC (AUTH_MODE=oidc) ----------------------
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_AUDIENCE=api://<api-app-id>
# OIDC_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# BOOTSTRAP_ADMIN_SUBJECT=<your IdP subject (sub) claim>
MAX_TOKEN_LIFETIME_SECONDS=5400
